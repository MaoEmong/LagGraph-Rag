OPENAI_API_KEY=your_openai_api_key_here
CHROMA_PATH=./data/chroma
DOCSTORE_PATH=./data/docstore.sqlite
CHECKPOINT_PATH=./data/checkpoints.sqlite
LOG_PATH=./logs

# DB options
# DB_ENABLED=false
# DB_ADAPTER=mock  # mock | mysql | postgres
# DB_URL=mysql://user:pass@localhost:3306/dbname
# DB_ROW_LIMIT=100
# DB_TIMEOUT_SEC=5
# DB_MAX_FILTERS=10
# DB_MAX_JOINS=5
# DB_MAX_GROUP_BY=5
# DB_MAX_METRICS=5
# DB_MAX_ORDER_BY=3
# DB_MAX_SELECT=5
# DB_DENYLIST_KEYWORDS=drop,delete,update,insert,alter,truncate
# DB_PLAN_MODEL=gpt-4o-mini
# DB_PLAN_MODEL_FALLBACKS=gpt-4.1-mini,gpt-4.1,gpt-4o
# DB_PLAN_TEMPERATURE=0.0
# DB_PLAN_MAX_OUTPUT_TOKENS=256

# Reranker options (defaults)
# RERANKER_ON=false  # deprecated (use RERANKER_MODE)
# RERANKER_MODE=off  # off | auto | always
# RERANK_TOP_K=20
# RERANKER_MODEL=none
# RERANKER_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_DEVICE=cuda
# RERANKER_TIMEOUT_SEC=10
# RERANKER_SCORE_THRESHOLD=-1.0
# RERANKER_DISTANCE_THRESHOLD=0.6
# RERANKER_BATCH_SIZE=16

# LLM fallback options
# LLM_MODEL_FALLBACKS=gpt-4.1-mini,gpt-4.1,gpt-4o

# Answer grounding options
# REQUIRE_CONTEXT_FOR_ANSWER=true
# NO_CONTEXT_MESSAGE=제공된 근거가 없어 답변할 수 없습니다.

# Re-query options
# REQUERY_ENABLED=true
# REQUERY_MAX_ATTEMPTS=1
# REQUERY_MIN_DOCS=2
# REQUERY_MIN_CITATIONS=1
# REQUERY_MODEL=gpt-4o-mini
# REQUERY_MODEL_FALLBACKS=gpt-4.1-mini,gpt-4.1,gpt-4o
# REQUERY_TEMPERATURE=0.0
# REQUERY_MAX_OUTPUT_TOKENS=64

# OCR options
OCR_ENABLED=true
OCR_LANG=kor+eng
OCR_DPI=200
OCR_MAX_PAGES=0
OCR_MIN_TEXT_LEN=100
